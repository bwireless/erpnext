# ---------- Galaxy PSA deployment env ----------
# Copy to .env in this directory and fill in.

# Public hostname that Traefik will get a Let's Encrypt cert for.
GALAXY_SITE_NAME=galaxy.ekosmos.com

# Bench site admin login (user Administrator).
GALAXY_ADMIN_PASSWORD=change_me_strong

# MariaDB root password (used to bootstrap the site).
MARIADB_ROOT_PASSWORD=change_me_strong

# Email that Let's Encrypt sends renewal warnings to.
LETSENCRYPT_EMAIL=ops@ekosmos.com

# ---------- AI ----------
# Anthropic API key for AI ticket triage. Leave blank to disable.
GALAXY_ANTHROPIC_API_KEY=
# Override the default Claude model if desired.
GALAXY_ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Timezone ----------
TZ=America/New_York
